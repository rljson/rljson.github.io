{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Development server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Preview page",
      "request": "launch",
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s/${fileDirnameBasename}/${fileBasenameNoExtension}/"
      },
      "type": "node-terminal"
    }
  ]
}
